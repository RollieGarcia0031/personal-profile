  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:local": "BASE_URL=/ pnpm build",
    "build:vercel": "BASE_URL=/ pnpm build",
    "build:github-pages": "BASE_URL=/personal-profile/ pnpm build",
    "preview": "vite preview",
    "generate:track-info": "node scripts/generate-track-info.mjs",
    "prebuild": "pnpm generate:track-info && pnpm generate:image-cache-manifest",

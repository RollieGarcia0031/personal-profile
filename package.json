    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:unit": "vitest run --config vitest.config.js --project unit --passWithNoTests",
    "test:integration": "vitest run --config vitest.config.js --project integration --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:watch": "vitest --config vitest.config.js --passWithNoTests"
